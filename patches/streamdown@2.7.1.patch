new file mode 100644
index 0000000000000000000000000000000000000000..c9b8cff90c9661a3778ef765f8d0c05691f2b8cb
--- /dev/null
+++ b/dist/diagram-raster.js
@@ -0,0 +1,80 @@
+const MAX_JPG_DIMENSION = 4096;
+
+/** Inline the displayed diagram's theme and bound the opaque JPG raster size. */
+function prepareJpgSvg(source, container) {
+  const svgDocument = new DOMParser().parseFromString(source, 'image/svg+xml');
+  const svg = svgDocument.documentElement;
+  if (svg.localName !== 'svg' || svgDocument.querySelector('parsererror')) {
+    throw new Error('Invalid SVG for JPG export');
+  }
+
+  const preview = container?.querySelector('[data-streamdown="mermaid"] [role="img"] > svg');
+  const styles = getComputedStyle(preview ?? container ?? globalThis.document.documentElement);
+  const background = styles.getPropertyValue('--pele-bg').trim() || styles.getPropertyValue('--background').trim() || '#ffffff';
+  svg.style.setProperty('--pele-bg', background);
+  svg.style.setProperty('--pele-fg', styles.color);
+  for (const name of styles) {
+    if (name.startsWith('--pele-')) {
+      svg.style.setProperty(name, styles.getPropertyValue(name));
+    }
+  }
+  svg.style.fontFamily = styles.fontFamily;
+
+  const viewBox = svg.viewBox.baseVal;
+  const width = viewBox.width || Number.parseFloat(svg.getAttribute('width'));
+  const height = viewBox.height || Number.parseFloat(svg.getAttribute('height'));
+  if (!(width > 0 && height > 0 && Number.isFinite(width) && Number.isFinite(height))) {
+    throw new Error('Invalid diagram dimensions for JPG export');
+  }
+  const scale = Math.min(2, MAX_JPG_DIMENSION / Math.max(width, height));
+  const rasterWidth = Math.max(1, Math.round(width * scale));
+  const rasterHeight = Math.max(1, Math.round(height * scale));
+  svg.setAttribute('width', String(rasterWidth));
+  svg.setAttribute('height', String(rasterHeight));
+  svg.style.width = `${rasterWidth}px`;
+  svg.style.height = `${rasterHeight}px`;
+  svg.style.maxWidth = 'none';
+
+  return { source: new XMLSerializer().serializeToString(svg), background };
+}
+
+/** Load a self-contained SVG using the same data-image CSP allowance as PNG export. */
+function loadSvgImage(source) {
+  return new Promise((resolve, reject) => {
+    const image = new Image();
+    image.onload = () => resolve(image);
+    image.onerror = () => reject(new Error('Failed to load SVG image'));
+    image.src = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(source)}`;
+  });
+}
+
+/** Export PNG at its existing scale, or a themed, opaque JPG capped at 4096 pixels per side. */
+export async function svgToRasterBlob(source, mimeType, container, maxDimension = Infinity) {
+  const jpg = mimeType === 'image/jpeg';
+  const prepared = jpg ? prepareJpgSvg(source, container) : { source, background: undefined };
+  const image = await loadSvgImage(prepared.source);
+  const canvas = globalThis.document.createElement('canvas');
+  const scale = Math.min(jpg ? 1 : 5, maxDimension / Math.max(image.width, image.height));
+  canvas.width = Math.max(1, Math.round(image.width * scale));
+  canvas.height = Math.max(1, Math.round(image.height * scale));
+  const context = canvas.getContext('2d');
+  if (!context) {
+    throw new Error('Failed to create 2D canvas context for diagram export');
+  }
+  if (jpg) {
+    context.fillStyle = '#ffffff';
+    context.fillRect(0, 0, canvas.width, canvas.height);
+    context.fillStyle = prepared.background;
+    context.fillRect(0, 0, canvas.width, canvas.height);
+  }
+  context.drawImage(image, 0, 0, canvas.width, canvas.height);
+  return await new Promise((resolve, reject) => {
+    canvas.toBlob((blob) => {
+      if (!blob) {
+        reject(new Error('Failed to create diagram image'));
+        return;
+      }
+      resolve(blob);
+    }, mimeType, 0.95);
+  });
+}
