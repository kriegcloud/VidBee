{
  "name": "@vidbee/cli",
  "version": "0.1.0",
  "description": "VidBee CLI \u2014 standalone yt-dlp wrapper that talks to the shared VidBee TaskQueue. Works against a local Desktop, a remote API, or fully in-process for CI / Docker / agents.",
  "homepage": "https://github.com/nexmoe/vidbee/tree/main/apps/cli#readme",
  "bugs": {
    "url": "https://github.com/nexmoe/vidbee/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexmoe/vidbee.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "VidBee Authors",
  "type": "module",
  "bin": {
    "vidbee": "./dist/bin/vidbee.mjs"
  },
  "main": "./dist/library/index.js",
  "types": "./dist/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./dist/library/index.js"
    },
    "./parser": {
      "types": "./src/parser/index.ts",
      "import": "./src/parser/index.ts",
      "default": "./dist/library/parser/index.js"
    },
    "./envelope": {
      "types": "./src/envelope/index.ts",
      "import": "./src/envelope/index.ts",
      "default": "./dist/library/envelope/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/library/index.d.ts",
        "import": "./dist/library/index.js",
        "default": "./dist/library/index.js"
      },
      "./parser": {
        "types": "./dist/library/parser/index.d.ts",
        "import": "./dist/library/parser/index.js",
        "default": "./dist/library/parser/index.js"
      },
      "./envelope": {
        "types": "./dist/library/envelope/index.d.ts",
        "import": "./dist/library/envelope/index.js",
        "default": "./dist/library/envelope/index.js"
      }
    },
    "main": "./dist/library/index.js",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "vidbee",
    "yt-dlp",
    "video",
    "video-downloader",
    "downloader",
    "cli",
    "agent",
    "automation"
  ],
  "scripts": {
    "typecheck": "tsrs -p tsconfig.test.json",
    "build": "node scripts/build.mjs",
    "verify-dist": "node scripts/verify-dist.mjs",
    "prepublishOnly": "bun run build && bun run verify-dist",
    "test": "bunx --bun vitest run",
    "test:node": "VIDBEE_CLI_PORTED=1 node --import tsx --test ../../scripts/cli/characterization/isolate.node.ts",
    "check": "tsrs -p tsconfig.json --emitDeclarationOnly && tsrs -p tsconfig.test.json && biome check ."
  },
  "dependencies": {
    "effect": "catalog:",
    "@effect/platform-node": "catalog:",
    "@vidbee/schema": "workspace:^",
    "@vidbee/task-queue": "workspace:^",
    "@vidbee/downloader-core": "workspace:^",
    "@vidbee/db": "workspace:^",
    "yt-dlp-wrap-plus": "catalog:"
  },
  "optionalDependencies": {
    "better-sqlite3": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:",
    "tsx": "catalog:",
    "tsrs": "catalog:",
    "@biomejs/biome": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
