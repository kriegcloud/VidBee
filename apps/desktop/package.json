{
  "name": "vidbee",
  "version": "2.4.0",
  "description": "Free, open-source desktop app to download media, create local transcripts, and ask AI",
  "main": "./out/main/index.js",
  "author": "VidBee",
  "homepage": "https://github.com/nexmoe/vidbee",
  "scripts": {
    "check": "biome check --config-path ../../biome.legacy.jsonc . && bun run check:i18n && bun run typecheck",
    "check:i18n": "node scripts/check-locales.js",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "prepare:native-deps": "node scripts/ensure-native-deps.mjs",
    "start": "bun run prepare:native-deps && electron-vite preview",
    "dev": "bun run setup && bun run prepare:native-deps && node scripts/set-console-encoding.js && electron-vite dev",
    "dev:kernel": "bun run dev -- --kernel-preparation-preview",
    "build": "electron-vite build",
    "setup": "node scripts/setup-dev-binaries.js",
    "build:ytdlp": "node scripts/build-vendored-ytdlp.js",
    "verify:ytdlp": "node scripts/verify-vendored-ytdlp.js",
    "postinstall": "node scripts/postinstall.mjs",
    "build:unpack": "bun run setup && bun run build && electron-builder --dir",
    "build:win": "bun run setup && node scripts/check-ytdlp.js win && bun run build && electron-builder --win --publish never && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-windows-portable-folder.ps1",
    "build:mac": "bun run setup && node scripts/check-ytdlp.js mac && bun run build && electron-builder --mac --publish never",
    "build:linux": "bun run setup && node scripts/check-ytdlp.js linux && bun run build && electron-builder --linux --publish never",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "fix": "biome check --write --config-path ../../biome.legacy.jsonc ."
  },
