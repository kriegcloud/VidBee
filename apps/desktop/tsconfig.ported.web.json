{
  "extends": "../../tsconfig.base.json",
  "files": [],
  "include": [],
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "noEmit": true,
    "incremental": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "unplugin-icons/types/react"],
    "paths": {
      "@main/*": ["./src/main/*"],
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  }
}
