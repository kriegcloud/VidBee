{
  "extends": ["./.wxt/tsconfig.json", "../../tsconfig.base.json"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "rootDir": ".",
    "noEmit": false
  },
  "include": [
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "wxt.config.ts",
    ".wxt/wxt.d.ts"
  ],
  "exclude": ["test", ".output", "dist", "node_modules"]
}
