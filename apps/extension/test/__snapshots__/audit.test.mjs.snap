exports[`complete WXT manifest pins trusted key, permissions and locale identity 1`] = `
{
  "manifest": {
    "default_locale": "en",
    "description": "__MSG_extensionDescription__",
    "host_permissions": [
      "http://127.0.0.1/*",
    ],
    "key": "",
    "name": "__MSG_extensionName__",
    "permissions": [
      "activeTab",
      "storage",
    ],
  },
  "modules": [
    "@wxt-dev/module-react",
  ],
}
`;

