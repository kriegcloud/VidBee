{
  "name": "api",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/ensure-node-sqlite.mjs && tsx watch src/index.ts",
    "start": "node scripts/ensure-node-sqlite.mjs && tsx src/index.ts",
    "migrate-history": "tsx scripts/migrate-history.ts",
    "before-start": "node scripts/ensure-node-sqlite.mjs && tsx scripts/migrate-history.ts && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "ultracite check && bun run typecheck"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@vidbee/browser-capture": "workspace:^",
    "@vidbee/db": "workspace:^",
    "@vidbee/downloader-core": "workspace:^",
    "@vidbee/logger": "workspace:^",
    "@vidbee/subscriptions-core": "workspace:^",
    "@vidbee/task-queue": "workspace:^",
    "@vidbee/transcription": "workspace:^",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "playwright-core": "catalog:"
  },
  "devDependencies": {
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:"
  }
}
