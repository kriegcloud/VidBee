{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "useSortedInterfaceMembers": "off",
        "useSortedKeys": "off",
        "useSortedPackageJson": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUndeclaredDependencies": "off",
        "useExhaustiveDependencies": "warn",
        "useImageSize": "off"
      },
      "suspicious": {
        "noEqualsToNull": "off",
        "noExplicitAny": "warn",
        "noLeakedRender": "off",
        "noShadow": "off",
        "noUnnecessaryConditions": "off",
        "useAwait": "off",
        "noEmptyBlockStatements": "off"
      },
      "style": {
        "useConst": "error",
        "noIncrementDecrement": "off",
        "noNestedTernary": "off",
        "useCollapsedElseIf": "off",
        "useConsistentArrowReturn": "off",
        "useConsistentMethodSignatures": "off",
        "useDestructuring": "off",
        "useErrorCause": "off",
        "useFilenamingConvention": "off",
        "noExportedImports": "off"
      },
      "complexity": {
        "noForEach": "off",
        "noUselessReturn": "off",
        "noUselessUndefined": "off",
        "noVoid": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "noAwaitInLoops": "off",
        "noJsxPropsBind": "off",
        "useTopLevelRegex": "off",
        "noNamespaceImport": "off"
      },
      "a11y": {
        "noNoninteractiveElementInteractions": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "globals": [
      "browser",
      "defineBackground"
    ],
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded"
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [

      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json",
      "!apps/desktop/build",
      "!**/src/main/ipc/DocumentSubscriptions.layer.ts",
      "!**/src/main/ipc/ElectronRpcAdmission.layer.ts",
      "!**/src/renderer/src/transport/DesktopRpcConnection.driver.ts",
      "!**/src/renderer/src/transport/DocumentDelivery.layer.ts",
      "!**/test/TransportRuntime.entry.ts",
      "!**/src/main/ipc/DocumentSubscriptions.service.ts",
      "!**/src/main/ipc/ElectronRpcAdmission.service.ts",
      "!**/src/main/ipc/ElectronRpcServer.driver.ts",
      "!**/src/main/ipc/ElectronRpcServer.layer.ts",
      "!**/src/main/ipc/Publication.service.ts",
      "!**/src/main/lib/DesktopNotifications.service.ts",
      "!**/src/main/lib/JsonSyntax.service.ts",
      "!**/src/main/lib/OriginalFailure.errors.ts",
      "!**/src/main/lib/SynchronousHost.service.ts",
      "!**/src/main/runtime/ApplicationOperations.layer.ts",
      "!**/src/main/runtime/ApplicationOperations.service.ts",
      "!**/src/main/runtime/SynchronousHost.entry.ts",
      "!**/src/preload/DesktopRpcBridge.driver.ts",
      "!**/src/renderer/src/runtime/RendererInvocation.entry.ts",
      "!**/src/renderer/src/runtime/StreamRecovery.atoms.ts",
      "!**/src/renderer/src/transport/DesktopRpcBridge.d.ts",
      "!**/src/renderer/src/transport/DocumentDelivery.errors.ts",
      "!**/src/renderer/src/transport/DocumentDelivery.model.ts",
      "!**/src/renderer/src/transport/DocumentDelivery.service.ts",
      "!**/src/renderer/src/transport/ElectronRpc.model.ts",
      "!**/src/renderer/src/transport/ElectronRpcClient.layer.ts",
      "!**/src/renderer/src/transport/RpcCensus.model.ts",
      "!**/src/renderer/src/transport/RpcField.model.ts",
      "!**/src/renderer/src/transport/RpcObservation.model.ts",
      "!**/test/foundation-transport.spec.ts",
      "!**/src/renderer/src/transport/census/Transcript.rpc.ts",
      "!**/src/renderer/src/transport/census/Transcript.model.ts",
      "!**/src/renderer/src/transport/census/Transcript.errors.ts",
      "!**/src/renderer/src/transport/census/Subscription.rpc.ts",
      "!**/src/renderer/src/transport/census/Subscription.model.ts",
      "!**/src/renderer/src/transport/census/Subscription.errors.ts",
      "!**/src/renderer/src/transport/census/StoredThread.model.ts",
      "!**/src/renderer/src/transport/census/RemoteCaptions.model.ts",
      "!**/src/renderer/src/transport/census/Integration.rpc.ts",
      "!**/src/renderer/src/transport/census/Integration.model.ts",
      "!**/src/renderer/src/transport/census/Downloads.rpc.ts",
      "!**/src/renderer/src/transport/census/Cloud.model.ts",
      "!**/src/renderer/src/transport/census/AiNative.model.ts",
      "!**/src/renderer/src/transport/census/Ai.rpc.ts",
      "!**/test/ElectronLifecycle.entry.ts",
      "!**/test/ElectronLifecycle.driver.ts",


      "!apps/desktop/dist",
      "!apps/desktop/out",
      "!packages/ui/src/components/ui/command-menu.tsx",
      "!packages/ui/src/components/ui/fluid-hover-highlight.tsx",
      "!packages/ui/src/components/ui/tabs-subtle.tsx",
      "!packages/ui/src/lib/popup.ts",
      "!packages/ui/src/hooks/use-fluid-hover.ts",
      "!packages/ui/src/components/ui/slider.tsx",
      "!packages/ui/src/components/ui/switch.tsx",
      "!packages/ui/src/components/ui/tabs.tsx",
      "!packages/ui/src/components/ui/thinking-steps.tsx",
      "!packages/ui/src/lib/shape-context.tsx",
      "!packages/ui/src/lib/icon-context.tsx",
      "!packages/ui/src/lib/surface-context.tsx",
      "!packages/ui/src/lib/surface-classes.ts",
      "!packages/ui/src/hooks/use-proximity-hover.ts",
      "!vendor",
      "!packages/ui/src/hooks/use-touch-primary.ts",
      "!packages/ui/src/components/ui/scroll-area.tsx",
      "!dist",
      "!**/src/main/logging/**",
      "!**/src/shared/logging/**",
      "!**/src/preload/logging/**",
      "!**/src/renderer/src/logging/**",
      "!**/desktop-logging.spec.ts",
      "!**/desktop-otlp.spec.ts",
      "!out",
      "!build"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": "../.."
  },
  "extends": [
    "./standards/biome-legacy/core.jsonc",
    "./standards/biome-legacy/react.jsonc"
  ]
}
