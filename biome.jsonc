{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "root": true,
  "files": {
    "includes": [
      "apps/desktop/src/shared/agent-permissions.ts",
      "apps/desktop/src/shared/extension-cookies.ts",
      "apps/desktop/src/shared/Tts.model.ts",
      "apps/desktop/src/shared/types/Desktop.model.ts",
      "apps/desktop/src/shared/types/index.ts",
      "apps/desktop/src/shared/types/ytdlp-kernel.ts",

      "apps/desktop/src/shared/Settings.errors.ts",
      "apps/desktop/src/shared/Settings.rpc.ts",
      "apps/desktop/src/shared/Settings.model.ts",
      "apps/desktop/test/settings-model.spec.ts",
      "apps/desktop/src/**/logging/**",
      "apps/desktop/test/desktop-logging.spec.ts",
      "apps/desktop/test/desktop-otlp.spec.ts",
      "apps/desktop/src/main/ipc/DocumentSubscriptions.layer.ts",
      "apps/desktop/src/main/ipc/ElectronRpcAdmission.layer.ts",
      "apps/desktop/src/renderer/src/transport/DesktopRpcConnection.driver.ts",
      "apps/desktop/src/renderer/src/transport/DocumentDelivery.layer.ts",
      "apps/desktop/test/TransportRuntime.entry.ts",
      "apps/cli/**",
      "apps/desktop/src/main/ipc/DocumentSubscriptions.service.ts",
      "apps/desktop/src/main/ipc/ElectronRpcAdmission.service.ts",
      "apps/desktop/src/main/ipc/ElectronRpcServer.driver.ts",
      "apps/desktop/src/main/ipc/ElectronRpcServer.layer.ts",
      "apps/desktop/src/main/ipc/Publication.service.ts",
      "apps/desktop/src/main/lib/DesktopNotifications.service.ts",
      "apps/desktop/src/main/lib/JsonSyntax.service.ts",
      "apps/desktop/src/main/lib/OriginalFailure.errors.ts",
      "apps/desktop/src/main/lib/SynchronousHost.service.ts",
      "apps/desktop/src/main/runtime/ApplicationOperations.layer.ts",
      "apps/desktop/src/main/runtime/ApplicationOperations.service.ts",
      "apps/desktop/src/main/runtime/SynchronousHost.entry.ts",
      "apps/desktop/src/preload/DesktopRpcBridge.driver.ts",
      "apps/desktop/src/renderer/src/runtime/RendererInvocation.entry.ts",
      "apps/desktop/src/renderer/src/runtime/StreamRecovery.atoms.ts",
      "apps/desktop/src/renderer/src/transport/DesktopRpcBridge.d.ts",
      "apps/desktop/src/renderer/src/transport/DocumentDelivery.errors.ts",
      "apps/desktop/src/renderer/src/transport/DocumentDelivery.model.ts",
      "apps/desktop/src/renderer/src/transport/DocumentDelivery.service.ts",
      "apps/desktop/src/renderer/src/transport/ElectronRpc.model.ts",
      "apps/desktop/src/renderer/src/transport/ElectronRpcClient.layer.ts",
      "apps/desktop/src/renderer/src/transport/RpcCensus.model.ts",
      "apps/desktop/src/renderer/src/transport/RpcField.model.ts",
      "apps/desktop/src/renderer/src/transport/RpcObservation.model.ts",
      "apps/desktop/test/foundation-transport.spec.ts",
      "apps/desktop/src/renderer/src/transport/census/Transcript.rpc.ts",
      "apps/desktop/src/renderer/src/transport/census/Transcript.model.ts",
      "apps/desktop/src/renderer/src/transport/census/Transcript.errors.ts",
      "apps/desktop/src/renderer/src/transport/census/Subscription.rpc.ts",
      "apps/desktop/src/renderer/src/transport/census/Subscription.model.ts",
      "apps/desktop/src/renderer/src/transport/census/Subscription.errors.ts",
      "apps/desktop/src/renderer/src/transport/census/StoredThread.model.ts",
      "apps/desktop/src/renderer/src/transport/census/RemoteCaptions.model.ts",
      "apps/desktop/src/renderer/src/transport/census/Integration.rpc.ts",
      "apps/desktop/src/renderer/src/transport/census/Integration.model.ts",
      "apps/desktop/src/renderer/src/transport/census/Downloads.rpc.ts",
      "apps/desktop/src/renderer/src/transport/census/Cloud.model.ts",
      "apps/desktop/src/renderer/src/transport/census/AiNative.model.ts",
      "apps/desktop/src/renderer/src/transport/census/Ai.rpc.ts",
      "apps/desktop/test/ElectronLifecycle.entry.ts",
      "apps/desktop/test/ElectronLifecycle.driver.ts",

      "!apps/cli/scripts/**",
      "packages/schema/**",
      "packages/identity/**",
      "tooling/standards/**",
      "apps/extension/**",
      "!apps/extension/assets/content.css",
      "!apps/extension/.wxt",
      "!apps/extension/.output",
      "!apps/extension/test/fixtures/**",
      "!apps/extension/test/**/*.mjs",
      "!apps/extension/test/__snapshots__/**",
      "packages/logger/**",
      "packages/db/**",
      "packages/task-queue/**",
      "packages/downloader-core/**",
      "packages/browser-capture/**",
      "packages/subscriptions-core/**",
      "packages/transcription/**",
      "!packages/db/test/fixtures/**",
      "!packages/db/test/snapshots/**",
      "packages/i18n/**",
      "!packages/i18n/src/locales/**",
      "!**/dist",
      "!**/node_modules",
      "!packages/logger/src/script.mjs"
    ]
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "trailingCommas": "none",
      "lineWidth": 80
    },
    "parser": {
      "allowComments": true
    }
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "indentStyle": "space",
    "indentWidth": 2,
    "formatWithErrors": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "jsxQuoteStyle": "double",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "trailingCommas": "es5"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedInterfaceMembers": "on",
        "useSortedKeys": {
          "level": "off",
          "options": {
            "sortOrder": "natural"
          }
        },
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              {
                "type": false
              },
              {
                "type": true
              }
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "turborepo": "recommended"
    },
    "rules": {
      "security": {
        "noDangerouslySetInnerHtml": "warn",
        "noGlobalEval": "error"
      },
      "a11y": {
        "useFocusableInteractive": "off",
        "useAriaPropsForRole": "off",
        "useSemanticElements": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      },
      "complexity": {
        "noBannedTypes": "off",
        "noUselessConstructor": "warn",
        "noUselessFragments": "off",
        "noThisInStatic": "off",
        "noForEach": "off",
        "noStaticOnlyClass": "off",
        "noArguments": "off",
        "noCommaOperator": "off",
        "noUselessUndefinedInitialization": "off",
        "useLiteralKeys": {
          "fix": "unsafe",
          "level": "error",
          "options": {}
        }
      },
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": {
          "level": "error",
          "fix": "none",
          "options": {}
        },
        "noUnusedVariables": "off",
        "useUniqueElementIds": "off",
        "useYield": "off",
        "noChildrenProp": "off",
        "noSwitchDeclarations": "off",
        "noUndeclaredVariables": "off",
        "useExhaustiveDependencies": "off",
        "noUnusedFunctionParameters": "off",
        "useHookAtTopLevel": "off"
      },
      "performance": {
        "noDelete": "off",
        "noAccumulatingSpread": "off"
      },
      "suspicious": {
        "noDeprecatedImports": "off",
        "noConsole": "warn",
        "noVar": "error",
        "noControlCharactersInRegex": "off",
        "noSelfCompare": "off",
        "noUnsafeDeclarationMerging": "off",
        "useAdjacentOverloadSignatures": "off",
        "noDoubleEquals": "off",
        "noPrototypeBuiltins": "off",
        "noDebugger": "error",
        "noRedeclare": "off",
        "noConfusingVoidType": "off",
        "noShadowRestrictedNames": "off",
        "noAssignInExpressions": "off",
        "noArrayIndexKey": "off",
        "noExplicitAny": "warn",
        "useIterableCallbackReturn": "off",
        "noTemplateCurlyInString": "off",
        "noThenProperty": "off",
        "noDuplicateObjectKeys": "off",
        "noCommentText": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "separatedType"
          }
        },
        "noUnusedTemplateLiteral": "off",
        "noParameterAssign": "off",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSelfClosingElements": "error",
        "useSingleVarDeclarator": "error",
        "useNumberNamespace": "error",
        "useConsistentArrowReturn": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "uuid": "Use the effect/crypto services: SecureRandom.uuidV4, SecureRandom.uuidV7, or Digest for name-based ids. uuid is not a repository dependency."
            },
            "patterns": [
              {
                "group": ["uuid/**"],
                "message": "Use the effect/crypto services: SecureRandom.uuidV4, SecureRandom.uuidV7, or Digest for name-based ids. uuid is not a repository dependency."
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "**/test/**",
        "**/__tests__/**",
        "**/*.test.*",
        "**/*.spec.*",
        "**/examples/**",
        "**/*.stories.*",
        "**/stories/**",
        "**/scripts/**",
        "**/*.bench.*",
        "**/seed/**",
        "**/seeds/**",
        "**/bin.ts",
        "**/bin-main.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    }
  ]
}
