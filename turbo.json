{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "check": {
      "dependsOn": [
        "^check"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^check"
      ],
      "outputs": [],
      "env": [
        "DB_TEST_CLIENT"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "vidbee-extension#check": {
      "outputs": [
        "dist/**",
        ".wxt/**"
      ]
    },
    "vidbee-extension#test": {
      "outputs": [
        ".wxt/**"
      ],
      "env": [
        "TZ"
      ]
    },
    "vidbee-extension#build": {
      "outputs": [
        ".output/**",
        ".wxt/**"
      ]
    }
  },
  "globalEnv": [
    "NODE_ENV",
    "VIDBEE_LOG_SERVICE"
  ],
  "globalDependencies": [
    "tsconfig.base.json",
    "biome.jsonc",
    "standards/effect-allowlist.jsonc"
  ],
  "cacheDir": ".turbo/cache"
}
