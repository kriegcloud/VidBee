{
  "name": "@vidbee/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./history": "./src/history.ts",
    "./task-queue": "./src/task-queue.ts",
    "./subscriptions": "./src/subscriptions.ts",
    "./transcripts": "./src/transcripts.ts",
    "./prompt-runs": "./src/prompt-runs.ts",
    ".": "./src/index.ts",
    "./node": "./src/NodeSqlite.layer.ts",
    "./legacy": "./src/legacy/index.ts",
    "./legacy/task-queue": "./src/legacy/task-queue.ts",
    "./legacy/subscriptions": "./src/legacy/subscriptions.ts",
    "./legacy/transcripts": "./src/legacy/transcripts.ts",
    "./legacy/prompt-runs": "./src/legacy/prompt-runs.ts",
    "./Row": "./src/Row.ts",
    "./Db.errors": "./src/Db.errors.ts"
  },
  "types": "./src/history.ts",
  "scripts": {
    "check": "tsrs -p tsconfig.json --emitDeclarationOnly && tsrs -p tsconfig.test.json && biome check .",
    "test": "bunx --bun vitest run && DB_TEST_CLIENT=borrowed bunx --bun vitest run test/clients.test.ts && DB_TEST_CLIENT=node bunx --bun vitest run test/clients.test.ts",
    "build": "tsrs -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@vidbee/schema": "workspace:^"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@opentelemetry/api": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
    "typescript": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:",
    "drizzle-orm-rollback-fixture": "catalog:",
    "@effect/platform-node": "catalog:"
  }
}
