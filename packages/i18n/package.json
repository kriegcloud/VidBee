{
  "name": "@vidbee/i18n",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./languages": "./src/languages.ts",
    "./system-locale": "./src/system-locale.ts",
    "./locales/*": "./src/locales/*.json",
    "./legacy": "./src/legacy/index.ts",
    "./legacy/system-locale": "./src/legacy/system-locale.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "check": "tsrs -p tsconfig.json --emitDeclarationOnly && tsrs -p tsconfig.test.json && biome check .",
    "test": "bunx --bun vitest run",
    "build": "tsrs -p tsconfig.json"
  },
  "dependencies": {
    "effect": "catalog:",
    "@vidbee/schema": "workspace:^",
    "i18next": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@effect/vitest": "catalog:",
    "vitest": "catalog:"
  }
}
