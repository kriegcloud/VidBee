{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "src/**/*.json"],
  "compilerOptions": {
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-test",
    "noEmit": true,
