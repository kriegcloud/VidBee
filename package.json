{
  "name": "vidbee-workspace",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bench:audit": "tsx packages/task-queue-legacy/test/benchmark.ts",
    "build": "turbo run build --filter=vidbee",
    "build:desktop": "turbo run build --filter=vidbee",
    "build:extension": "bun run --cwd apps/extension build",
    "build:linux": "bun run --cwd apps/desktop build:linux",
    "build:mac": "bun run --cwd apps/desktop build:mac",
    "build:unpack": "bun run --cwd apps/desktop build:unpack",
    "build:win": "bun run --cwd apps/desktop build:win",
    "build:ytdlp": "bun run --cwd apps/desktop build:ytdlp",
    "check": "bun run check:legacy && turbo run check --filter=vidbee-extension --filter=@vidbee/cli --filter=@vidbee/cli-legacy --filter=@vidbee/schema --filter=@vidbee/logger --filter=@vidbee/i18n --filter=@vidbee/db --filter=@vidbee/task-queue --filter=@vidbee/task-queue-legacy --filter=@vidbee/downloader-core --filter=@vidbee/downloader-core-legacy --filter=@vidbee/transcription --filter=@vidbee/transcription-legacy --filter=@vidbee/subscriptions-core --filter=@vidbee/subscriptions-core-legacy --filter=@vidbee/browser-capture --filter=@vidbee/browser-capture-legacy && bun run port:check",
    "check:i18n": "bun run --cwd apps/desktop check:i18n",
    "db:generate": "bun run --cwd apps/desktop db:generate",
    "db:migrate": "bun run --cwd apps/desktop db:migrate",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "deps:update": "syncpack update --target=latest --dependency-types=catalog",
    "dev": "bun run --cwd apps/desktop dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:extension": "bun run --cwd apps/extension dev",
    "fix": "bun run --cwd apps/desktop fix",
    "prepare": "effect-tsgo unpatch --tsrs && effect-tsgo patch --tsrs && lefthook install --force",
    "setup": "bun run --cwd apps/desktop setup",
    "start": "bun run --cwd apps/desktop start",
    "test:golden": "node apps/desktop/scripts/port/golden/run.mjs",
    "test:audit": "VIDBEE_CLI_PORTED=1 node --import tsx --test apps/desktop/test/*.test.ts packages/task-queue-legacy/test/*.test.ts packages/downloader-core-legacy/test/*.node.ts packages/transcription-legacy/test/*.node.ts packages/ui/test/*.test.ts scripts/cli/characterization/*.node.ts && bun run --cwd packages/subscriptions-core-legacy test && bun run --cwd packages/browser-capture-legacy test:audit",
    "typecheck": "bun run --cwd apps/desktop typecheck",
    "verify:ytdlp": "bun run --cwd apps/desktop verify:ytdlp",
    "zip:extension": "bun run --cwd apps/extension zip",
    "check:legacy": "bun run --cwd apps/desktop check",
    "lint:legacy": "bun run --cwd apps/desktop check",
    "test": "bun run test:foundation && bun run test:audit:other && bun run --cwd packages/browser-capture-legacy test:audit && turbo run test --filter=vidbee-extension --filter=@vidbee/cli --filter=@vidbee/cli-legacy --filter=@vidbee/schema --filter=@vidbee/logger --filter=@vidbee/i18n --filter=@vidbee/db --filter=@vidbee/task-queue --filter=@vidbee/downloader-core --filter=@vidbee/downloader-core-legacy --filter=@vidbee/transcription --filter=@vidbee/transcription-legacy --filter=@vidbee/subscriptions-core --filter=@vidbee/browser-capture && bun run --cwd packages/browser-capture-legacy test:unit && node --test scripts/port-check.test.mjs scripts/schema-types.test.mjs && bunx --bun vitest run apps/desktop/scripts/port/golden/extension-browser.test.mjs apps/desktop/scripts/port/golden/phase8.test.mjs apps/desktop/scripts/port/golden/capture-command.test.mjs apps/desktop/scripts/port/golden/loopback.test.mjs apps/desktop/scripts/port/golden/subscriptions-core.test.mjs apps/desktop/scripts/port/golden/browser-capture.test.mjs apps/desktop/scripts/port/golden/transcription.test.mjs",
    "port:check": "node scripts/port-check.mjs",
    "test:audit:other": "VIDBEE_CLI_PORTED=1 node --import tsx --test apps/desktop/test/*.test.ts packages/task-queue-legacy/test/*.test.ts packages/downloader-core-legacy/test/*.node.ts packages/ui/test/*.test.ts scripts/cli/characterization/*.node.ts && bun run --cwd packages/subscriptions-core-legacy test",
    "test:audit:shared": "tsx --test apps/desktop/test/*.test.ts packages/task-queue-legacy/test/*.test.ts packages/downloader-core-legacy/test/*.node.ts packages/subscriptions-core/test/*.test.ts packages/ui/test/*.test.ts",
    "test:foundation": "node scripts/desktop-foundation/source-runner.mjs",
    "test:foundation:packaged": "node scripts/desktop-foundation/packaged.mjs"
  },
